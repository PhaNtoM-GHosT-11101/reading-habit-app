rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Community book uploads: files live at community/{userId}/{fileName}
    // Only the uploader may write; anyone signed-in may read (download)
    match /community/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('application/epub\\+zip|application/octet-stream');
      allow delete: if false;
    }

    // Everything else is private
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}